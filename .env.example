# Copy this file to .env and update values for your environment.
# Used for local development. Do NOT commit secrets to git.

# SNMP defaults
SNMP_COMMUNITY=public
SNMP_PORT=161

# Trap listener (disable in production unless you expose a UDP port)
# Use TRAP_ENABLED=true to run the trap listener inside the app.
TRAP_ENABLED=false
TRAP_PORT=1620
TRAP_COMMUNITY=${SNMP_COMMUNITY}

# Webhook to receive trap notifications. Leave empty to disable webhooks.
TRAP_WEBHOOK_URL=
# Optional: override auto-detected platform (discord|slack|telegram|generic)
TRAP_WEBHOOK_TYPE=
# For Telegram: set the chat or group id (e.g. -1001234567890)
TRAP_WEBHOOK_CHAT_ID=

# Retry and timeout settings for webhook delivery
TRAP_WEBHOOK_RETRIES=3
TRAP_WEBHOOK_TIMEOUT=10

# Batch intervals in seconds for trap severity batching
TRAP_CRITICAL_INTERVAL=300
TRAP_HIGH_INTERVAL=3600

# Example: enable trap listener and point to a local webhook
# TRAP_ENABLED=true
# TRAP_WEBHOOK_URL=http://localhost:9999/api/trap

# MySQL / MariaDB connection for monitoring data
# Defaults match XAMPP (root tanpa password di localhost).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=olt_monitoring

# Session secret - REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Set to false to disable history tables (traffic, rx_power, onu_status_log, hw_history).
# Core state tables (olts, onus, alerts, settings) remain active.
MONITOR_HISTORY_ENABLED=false